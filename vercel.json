
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reachinbox-assessment-xv55.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://reachinbox-assessment-xv55.onrender.com/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
